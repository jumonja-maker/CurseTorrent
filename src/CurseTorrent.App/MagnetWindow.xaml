<Window x:Class="CurseTorrent.App.MagnetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Magnet-ссылка — CurseTorrent" Width="620" Height="330" MinWidth="440" MinHeight="260" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="Добавить magnet-ссылку" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <TextBlock Text="Вставьте полную ссылку, начинающуюся с magnet:?" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="MagnetBox" Height="85" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" MaxLength="32768" AutomationProperties.Name="Magnet-ссылка" />
        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,9,0,0">
          <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Отмена" IsCancel="True" Width="105" Margin="0,0,9,0" />
      <Button x:Name="ContinueButton" Content="Продолжить" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnContinue" />
    </StackPanel>
  </Grid>
</Window>
