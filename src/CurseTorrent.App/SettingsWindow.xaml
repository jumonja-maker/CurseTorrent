<Window x:Class="CurseTorrent.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Настройки — CurseTorrent" Width="690" Height="760" MinHeight="630" MinWidth="640" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <TextBlock Text="ПАПКА ЗАГРУЗКИ ПО УМОЛЧАНИЮ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox" AutomationProperties.Name="Папка по умолчанию" /><Button Grid.Column="1" Content="Обзор…" Click="OnBrowse" Margin="9,0,0,0" /></Grid>
      <TextBlock Text="ОГРАНИЧЕНИЯ СКОРОСТИ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,9" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Скачивание, КиБ/с" Margin="0,0,0,7" /><TextBox x:Name="DownloadBox" MaxLength="7" AutomationProperties.Name="Ограничение скачивания в КиБ в секунду" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Отдача, КиБ/с" Margin="0,0,0,7" /><TextBox x:Name="UploadBox" MaxLength="7" AutomationProperties.Name="Ограничение отдачи в КиБ в секунду" /></StackPanel></Grid>
      <TextBlock Text="0 — без ограничения. 1 МиБ/с = 1024 КиБ/с." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
      <TextBlock Text="СОЕДИНЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,9" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Входящий порт TCP / UDP" Margin="0,0,0,7" /><TextBox x:Name="PortBox" MaxLength="5" AutomationProperties.Name="Входящий порт" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Максимум соединений" Margin="0,0,0,7" /><TextBox x:Name="ConnectionsBox" MaxLength="4" AutomationProperties.Name="Максимальное число соединений" /></StackPanel></Grid>
      <CheckBox x:Name="PortForwardingCheck" Content="Автоматически открыть порт на роутере (UPnP / NAT-PMP)" Margin="0,13,0,0" />
      <TextBlock Text="ПЕРЕЗАПУСК И ФОНОВАЯ РАБОТА" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,6" />
      <CheckBox x:Name="ResumeCheck" Content="Продолжать активные загрузки при запуске приложения" />
      <CheckBox x:Name="TrayCheck" Content="При закрытии окна продолжать работу в трее" />
      <TextBlock Text="Торренты продолжают раздаваться после завершения скачивания. Для остановки используйте паузу или выход из приложения." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
      <TextBlock Text="ОТКРЫТИЕ ТОРРЕНТОВ В WINDOWS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,9" />
      <WrapPanel><Button Content="Зарегистрировать приложение" Click="OnRegister" Margin="0,0,8,6" /><Button Content="Приложения по умолчанию" Click="OnDefaultApps" Margin="0,0,0,6" /></WrapPanel>
      <TextBlock Text="Регистрация добавит CurseTorrent в варианты открытия .torrent и magnet для вашего пользователя. Приложение по умолчанию выбирается в настройках Windows." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
      <TextBlock x:Name="RegistrationLabel" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2"><TextBlock x:Name="ErrorLabel" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,10" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Width="105" Margin="0,0,9,0" /><Button Content="Сохранить" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" Width="120" /></StackPanel></StackPanel>
  </Grid>
</Window>
