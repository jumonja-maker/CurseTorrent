<Window x:Class="CurseTorrent.App.AddTorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Добавить торрент — CurseTorrent" Width="760" Height="760" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Новая загрузка" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="TorrentName" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,9,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <TextBlock x:Name="TorrentSize" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <TextBlock Text="Сохранить в папку" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="DirectoryBox" AutomationProperties.Name="Папка загрузки" />
          <Button Grid.Column="1" Content="Обзор…" Click="OnBrowse" Margin="9,0,0,0" />
        </Grid>
        <Grid Margin="0,0,0,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Файлы для скачивания" VerticalAlignment="Center" />
          <StackPanel x:Name="SelectionControls" Grid.Column="1" Orientation="Horizontal">
            <Button Content="Выбрать все" Padding="10,5" MinHeight="27" Click="OnSelectAll" Margin="0,0,7,0" />
            <Button Content="Снять выбор" Padding="10,5" MinHeight="27" Click="OnSelectNone" />
          </StackPanel>
        </Grid>
        <Border x:Name="FilesPanel" Height="250" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
          <Grid>
            <DataGrid x:Name="FilesGrid" RowHeight="36" ColumnHeaderHeight="34" IsReadOnly="False" CanUserSortColumns="False" AutomationProperties.Name="Файлы новой загрузки">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40" MinWidth="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" AutomationProperties.Name="Скачать файл" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="ИМЯ ФАЙЛА" Binding="{Binding Path}" Width="*" MinWidth="160" IsReadOnly="True" />
                <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding Size}" Width="120" MinWidth="120" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer x:Name="MagnetHint" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel VerticalAlignment="Center" Margin="24">
                <TextBlock Text="Сначала — метаданные" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="Для magnet-ссылки имя и список файлов станут доступны после подключения к пирам. По умолчанию скачиваются все файлы; изменить выбор можно на вкладке «Файлы»." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <TextBlock x:Name="SelectionSummary" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="StartCheckBox" Content="Начать скачивание сразу" IsChecked="True" Margin="0,12,0,0" />
        <CheckBox x:Name="AllowExistingFilesCheck" Content="Разрешить дозагрузку в существующие файлы" IsChecked="False" Margin="0,12,0,0" />
        <TextBlock Text="Совпавшие файлы могут быть изменены. Для новой загрузки оставьте выключенным." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="25,5,0,0" />
        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" IsCancel="True" Width="105" Margin="0,0,9,0" />
      <Button x:Name="AddButton" Content="Добавить" IsDefault="True" Width="120" Style="{StaticResource PrimaryButton}" Click="OnAdd" />
    </StackPanel>
  </Grid>
</Window>
