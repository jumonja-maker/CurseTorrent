<Window x:Class="CurseTorrent.App.AddTorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Добавить торрент — CurseTorrent" Width="760" Height="640" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Новая загрузка" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="TorrentName" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,0" /><TextBlock x:Name="TorrentSize" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,18">
      <TextBlock Text="Сохранить в папку" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox" AutomationProperties.Name="Папка загрузки" /><Button Grid.Column="1" Content="Обзор…" Click="OnBrowse" Margin="9,0,0,0" /></Grid>
    </StackPanel>
    <Grid Grid.Row="2" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Файлы для скачивания" VerticalAlignment="Center" /><StackPanel x:Name="SelectionControls" Grid.Column="1" Orientation="Horizontal"><Button Content="Выбрать все" Padding="10,5" MinHeight="27" Click="OnSelectAll" Margin="0,0,7,0" /><Button Content="Снять выбор" Padding="10,5" MinHeight="27" Click="OnSelectNone" /></StackPanel></Grid>
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
      <Grid><DataGrid x:Name="FilesGrid" RowHeight="36" ColumnHeaderHeight="34" IsReadOnly="False" CanUserSortColumns="False"><DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" AutomationProperties.Name="Скачать файл" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="ИМЯ ФАЙЛА" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding Size}" Width="120" IsReadOnly="True" />
      </DataGrid.Columns></DataGrid>
        <StackPanel x:Name="MagnetHint" Visibility="Collapsed" VerticalAlignment="Center" Margin="35"><TextBlock Text="Сначала — метаданные" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Для magnet-ссылки имя и список файлов станут доступны после подключения к пирам. По умолчанию скачиваются все файлы; изменить выбор можно на вкладке «Файлы»." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" /></StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,12,0,10"><TextBlock x:Name="SelectionSummary" FontSize="12" Foreground="{StaticResource MutedBrush}" /><CheckBox x:Name="StartCheckBox" Content="Начать скачивание сразу" IsChecked="True" Margin="0,12,0,0" /><TextBlock x:Name="ErrorLabel" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Width="105" Margin="0,0,9,0" /><Button Content="Добавить" IsDefault="True" Width="120" Style="{StaticResource PrimaryButton}" Click="OnAdd" /></StackPanel>
  </Grid>
</Window>
