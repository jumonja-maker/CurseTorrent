<Window x:Class="CurseTorrent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="CurseTorrent" Width="1250" Height="800" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewDragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
  <Grid x:Name="MainLayout" Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="35" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid x:Name="SidebarLayout" Margin="14,24,14,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="BrandPanel" Margin="10,0,0,33">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0"><TextBlock Text="↓" Foreground="{DynamicResource CheckedTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" /></Border>
            <TextBlock Text="CURSE" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="TORRENT" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="40,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="ЗАГРУЗКИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,11" />
          <ListBox x:Name="Filters" SelectionChanged="OnFilterChanged" SelectedIndex="0">
            <ListBoxItem Tag="all"><TextBlock Text="Все торренты" /></ListBoxItem>
            <ListBoxItem Tag="downloading"><TextBlock Text="↓  Скачиваются" /></ListBoxItem>
            <ListBoxItem Tag="seeding"><TextBlock Text="↑  Раздаются" /></ListBoxItem>
            <ListBoxItem Tag="paused"><TextBlock Text="Ⅱ  На паузе" /></ListBoxItem>
            <ListBoxItem Tag="error"><TextBlock Text="!   Ошибки" /></ListBoxItem>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="2,0,2,0">
          <Button x:Name="SettingsButton" Content="Настройки" Click="OnSettings" HorizontalContentAlignment="Left" />
          <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="9,16,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceLayout" Grid.Column="1" Margin="26,25,26,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="116" /><RowDefinition Height="7" /><RowDefinition Height="0.65*" MinHeight="174" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="245" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="HeadingLabel" Text="Загрузки" FontSize="28" FontWeight="SemiBold" ToolTip="{Binding Text, ElementName=CountLabel}" /><TextBlock x:Name="CountLabel" Text="Добавьте первый торрент" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SearchCaption" Text="ПОИСК ПО ЗАГРУЗКАМ" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="1,0,0,5" /><TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Поиск по названию торрента" AutomationProperties.Name="Поиск по названию торрента" /></StackPanel>
      </Grid>
      <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="0,22,0,16">
        <Button Content="＋  Торрент" Style="{StaticResource PrimaryButton}" Click="OnAddTorrent" Margin="0,0,7,5" ToolTip="Открыть .torrent (Ctrl+O)" />
        <Button Content="Magnet" Click="OnAddMagnet" Margin="0,0,16,5" ToolTip="Добавить magnet-ссылку (Ctrl+M)" />
        <Button x:Name="ResumeButton" Content="▶" Click="OnResume" Margin="0,0,6,5" Width="38" ToolTip="Продолжить загрузку" AutomationProperties.Name="Продолжить загрузку" />
        <Button x:Name="PauseButton" Content="Ⅱ" Click="OnPause" Margin="0,0,6,5" Width="38" ToolTip="Поставить на паузу" AutomationProperties.Name="Пауза" />
        <Button x:Name="RecheckButton" Content="↻" Click="OnRecheck" Margin="0,0,6,5" Width="38" ToolTip="Проверить целостность файлов" AutomationProperties.Name="Проверить файлы" />
        <Button x:Name="FolderButton" Content="Папка" Click="OnOpenFolder" Margin="0,0,6,5" ToolTip="Открыть папку загрузки" />
        <Button x:Name="RemoveButton" Content="Удалить из списка" Click="OnRemove" Margin="0,0,0,5" ToolTip="Убрать торрент из списка, сохранив загруженные файлы" />
      </WrapPanel>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="TorrentGrid" SelectionChanged="OnTorrentSelected" IsReadOnly="True" Margin="1" CanUserSortColumns="True" AutomationProperties.Name="Список торрентов">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ИМЯ / СОСТОЯНИЕ" Width="*" MinWidth="195" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Hint}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" /></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding Size}" Width="92" MinWidth="92" SortMemberPath="Snapshot.SelectedSizeBytes" />
              <DataGridTemplateColumn Header="ПРОГРЕСС" Width="120" MinWidth="120" SortMemberPath="Progress"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,0,0,6" /><ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="↓ ПРИЁМ" Binding="{Binding Download}" Width="103" MinWidth="103" SortMemberPath="Snapshot.DownloadBytesPerSecond" />
              <DataGridTextColumn Header="↑ ОТДАЧА" Binding="{Binding Upload}" Width="103" MinWidth="103" SortMemberPath="Snapshot.UploadBytesPerSecond" />
              <DataGridTextColumn Header="ПИРЫ" Binding="{Binding Peers}" Width="60" MinWidth="60" SortMemberPath="Snapshot.ConnectedPeers" />
              <DataGridTextColumn Header="ОСТАЛОСЬ" Binding="{Binding Remaining}" Width="114" MinWidth="114" SortMemberPath="Snapshot.EstimatedRemaining" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20,30,20,0">
            <TextBlock Text="↓" FontSize="56" Foreground="{DynamicResource IllustrationBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="Здесь появятся ваши загрузки" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,10" />
            <TextBlock x:Name="EmptyDescription" Text="Перетащите .torrent в окно или добавьте magnet-ссылку" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
      <Border x:Name="DetailsPanel" Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,1,0,16">
        <Grid>
          <TextBlock x:Name="NoSelection" Text="Выберите торрент, чтобы посмотреть файлы и сведения" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TabControl x:Name="DetailsTabs" Visibility="Collapsed" Margin="6,0,6,6">
            <TabItem Header="Файлы">
              <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DataGrid x:Name="FilesGrid" RowHeight="36" ColumnHeaderHeight="31" CanUserSortColumns="True" AutomationProperties.Name="Файлы торрента">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ФАЙЛ" Binding="{Binding Path}" Width="*" MinWidth="160" IsReadOnly="True" />
                    <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding Size}" Width="105" MinWidth="105" IsReadOnly="True" SortMemberPath="SizeBytes" />
                    <DataGridTextColumn Header="ГОТОВО" Binding="{Binding ProgressText}" Width="85" MinWidth="85" IsReadOnly="True" SortMemberPath="Progress" />
                    <DataGridTemplateColumn Header="ПРИОРИТЕТ" Width="151" MinWidth="151" SortMemberPath="Priority"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Priorities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Приоритет файла" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="FilesHint" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="12,5,12,3" />
              </Grid>
            </TabItem>
            <TabItem Header="Сведения">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="13,13,13,6"><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Папка" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9" /><TextBlock x:Name="DetailsDirectory" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,9" />
                <TextBlock Text="Выбрано / всего" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9" /><TextBlock x:Name="DetailsSize" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" />
                <TextBlock Text="Получено / отдано" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9" /><TextBlock x:Name="DetailsTransferred" Grid.Row="2" Grid.Column="1" Margin="0,0,0,9" />
                <TextBlock Text="Пиры / сиды" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9" /><TextBlock x:Name="DetailsPeers" Grid.Row="3" Grid.Column="1" Margin="0,0,0,9" />
                <TextBlock Text="Состояние" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="DetailsState" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
              </Grid></ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Готово" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="TransferLabel" Grid.Column="1" Text="↓ —    ↑ —" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="20,0,0,0" /></Grid>
    </Border>
  </Grid>
</Window>
