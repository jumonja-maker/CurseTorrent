<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CurseTorrentRoot Condition="'$(CurseTorrentRoot)' == ''">../../..</CurseTorrentRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CurseTorrentRoot)/src/CurseTorrent.App/CurseTorrent.App.csproj" />
    <Content Include="$(CurseTorrentRoot)/src/CurseTorrent.App/App.xaml" Link="AppTheme.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
